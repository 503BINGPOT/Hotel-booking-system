<!DOCTYPE html>
<html>
<head>
  <title>Hotel Booking</title>
  <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="bg-zinc-800 text-white min-h-screen">

  <h2 class="text-2xl font-semibold mt-6 text-center">
    Hotel Reservation System
  </h2>

  <div class="flex justify-center gap-4 mt-6">
    <input id="roomCount" type="number"
      placeholder="No of Rooms"
      class="bg-zinc-700 border border-zinc-600 px-4 py-2 rounded w-56"/>

    <button onclick="bookRooms()" class="bg-zinc-700 px-6 py-2 rounded hover:bg-zinc-600">Book</button>
    <button onclick="resetRooms()" class="bg-zinc-700 px-6 py-2 rounded hover:bg-zinc-600">Reset</button>
    <button onclick="randomRooms()" class="bg-zinc-700 px-6 py-2 rounded hover:bg-zinc-600">Random</button>
  </div>

  <!-- travel time -->
  <div id="travelTime" class="mt-4 text-center text-lg text-zinc-300"></div>

  <div class="flex justify-center gap-12 mt-10">
    <div class="w-28 h-[500px] border-2 border-zinc-500 bg-zinc-700"></div>
    <div id="hotelGrid" class="flex flex-col gap-3"></div>
  </div>

  <script src="/script.js"></script>
</body>
</html>
